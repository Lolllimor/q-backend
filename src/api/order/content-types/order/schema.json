{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "reference": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "amount": {
      "type": "biginteger",
      "required": true
    },
    "paid": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "paid",
        "failed"
      ],
      "default": "pending",
      "required": true
    },
    "customerName": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string"
    },
    "artworkId": {
      "type": "biginteger"
    },
    "artworkDocumentId": {
      "type": "string"
    },
    "transactionId": {
      "type": "string"
    },
    "failureReason": {
      "type": "text"
    }
  }
}