{
  "kind": "collectionType",
  "collectionName": "artworks",
  "info": {
    "singularName": "artwork",
    "pluralName": "artworks",
    "displayName": "Artwork"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "Title": {
      "type": "string"
    },
    "Year": {
      "type": "integer"
    },
    "Collection": {
      "type": "string"
    },
    "BoughtBy": {
      "type": "text"
    },
    "Date": {
      "type": "string"
    },
    "Price": {
      "type": "biginteger"
    },
    "tags": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::tag.tag",
      "mappedBy": "artwork"
    },
    "art": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "sold": {
      "type": "boolean",
      "default": false,
      "required": false
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "draft",
        "published",
        "sold"
      ],
      "default": "draft"
    },
    "soldAt": {
      "type": "datetime"
    },
    "order": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::order.order",
      "mappedBy": "artworkDocumentId"
    }
  }
}